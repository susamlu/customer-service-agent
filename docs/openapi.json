{
  "openapi": "3.1.0",
  "info": {
    "title": "customer-service model service",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/plan": {
      "post": {
        "summary": "Plan",
        "description": "一次原子调用给出能力集、主题、实体与门控结果（architecture.md §3.1）。\n\n分类器只回答「问的是什么」，门控依赖会话历史，留在这里算。",
        "operationId": "plan_api_plan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/retrieve": {
      "post": {
        "summary": "Retrieve",
        "operationId": "retrieve_api_retrieve_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetrieveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Retrieve Api Retrieve Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/rerank": {
      "post": {
        "summary": "Rerank",
        "operationId": "rerank_api_rerank_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RerankRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Rerank Api Rerank Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/generate": {
      "post": {
        "summary": "Generate",
        "operationId": "generate_api_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retriable": {
            "type": "boolean",
            "title": "Retriable"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "retriable"
        ],
        "title": "ErrorResponse",
        "description": "§3.5 统一错误封装。code 取值见 §9。"
      },
      "GateDecision": {
        "properties": {
          "allowed": {
            "type": "boolean",
            "title": "Allowed"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "allowed",
          "reason"
        ],
        "title": "GateDecision"
      },
      "GenerateRequest": {
        "properties": {
          "messages": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Messages"
          },
          "max_new_tokens": {
            "type": "integer",
            "title": "Max New Tokens",
            "default": 200
          }
        },
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "GenerateRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PlanRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "PlanRequest"
      },
      "PlanResponse": {
        "properties": {
          "capabilities": {
            "items": {
              "type": "string",
              "enum": [
                "knowledge",
                "order",
                "human"
              ]
            },
            "type": "array",
            "title": "Capabilities"
          },
          "route_scores": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Route Scores"
          },
          "topic": {
            "$ref": "#/components/schemas/Topic"
          },
          "entities": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Entities"
          },
          "gate": {
            "additionalProperties": {
              "$ref": "#/components/schemas/GateDecision"
            },
            "type": "object",
            "title": "Gate"
          },
          "source": {
            "type": "string",
            "enum": [
              "rule",
              "bert"
            ],
            "title": "Source"
          },
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms"
          }
        },
        "type": "object",
        "required": [
          "capabilities",
          "route_scores",
          "topic",
          "entities",
          "gate",
          "source",
          "elapsed_ms"
        ],
        "title": "PlanResponse"
      },
      "RerankRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "candidates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Candidates"
          },
          "top_k": {
            "type": "integer",
            "title": "Top K",
            "default": 2
          }
        },
        "type": "object",
        "required": [
          "query",
          "candidates"
        ],
        "title": "RerankRequest"
      },
      "RetrieveRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "top_k": {
            "type": "integer",
            "title": "Top K",
            "default": 10
          },
          "intent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "RetrieveRequest"
      },
      "Topic": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "label",
          "confidence"
        ],
        "title": "Topic"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
